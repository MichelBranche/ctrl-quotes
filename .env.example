# Copia in .env.local. In locale l'app parte anche senza questo file:
# database su file, secret di sviluppo in data/dev-secret, email in console.

# Obbligatorie fuori dal localhost e su Vercel
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database. Locale: file libSQL. Hosted: URL Turso del database NUOVO di CTRL Quotes.
DATABASE_URL=file:./data/local.db
# TURSO_AUTH_TOKEN=

# Email: console | file | resend
EMAIL_DRIVER=console
# Conferma automatica solo in locale o anteprima. VERCEL_ENV=production la ignora sempre.
# Su Vercel Preview (VERCEL_ENV=preview) la conferma è già automatica, anche senza questa variabile.
# PREVIEW_AUTO_VERIFY_EMAIL=1
EMAIL_FROM="CTRL Quotes <quotes@example.com>"
# EMAIL_FILE_PATH=data/emails.jsonl
# RESEND_API_KEY=

# Google OAuth, opzionale
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Rate limit condiviso, opzionale. Senza queste variabili si usa la memoria del processo.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Blob privato, fasi successive
# BLOB_READ_WRITE_TOKEN=

# Fase 4, link pubblici dei preventivi. Tutte facoltative.
# Indirizzo base dei link mandati ai clienti. Unica impostazione da cambiare con un dominio nuovo.
# Se manca: NEXT_PUBLIC_APP_URL, poi BETTER_AUTH_URL. In produzione deve essere https.
# PUBLIC_QUOTE_BASE_URL=https://ctrl-quotes.vercel.app
# Host vecchi da reindirizzare (308) verso PUBLIC_QUOTE_BASE_URL, percorso e token inclusi. Separati da virgola.
# PUBLIC_QUOTE_LEGACY_HOSTS=ctrl-quotes.vercel.app
# Chiave per cifrare i token (32 byte: 64 caratteri hex o base64). Genera con: openssl rand -base64 32
# Se manca viene derivata da BETTER_AUTH_SECRET. Cambiarla non rompe i link, ma "Copia link" chiede di rigenerarli.
# QUOTE_LINK_KEY=

# Protegge /api/cron/outbox
# CRON_SECRET=

# Solo sviluppo locale. Non attivarle su Vercel.
ENABLE_COMPONENT_CATALOG=1
ENABLE_DEV_MAILBOX=1

# Editor visuale (anteprima). 1 abilita l'interruttore Modulo/Visuale.
# Su Vercel è impostato solo in Preview (NEXT_PUBLIC_EDITOR_VISUALE); in locale e nei test basta EDITOR_VISUALE.
NEXT_PUBLIC_EDITOR_VISUALE=
EDITOR_VISUALE=

# Invio dei preventivi ai clienti (fase 4). Acceso in sviluppo e sulle Preview, spento in Production
# finché la pagina cliente non è pronta. 1 lo accende ovunque, 0 lo spegne ovunque. Facoltativa.
# QUOTE_SENDING=
# Tetto globale quotidiano di email preventivo (tutta l'app, Europe/Rome). Default 90, per restare sotto il piano gratuito di Resend.
# QUOTE_SEND_GLOBAL_DAILY_CAP=90

# Stripe (Fase 5). Senza queste variabili la pagina Abbonamento resta com'è, senza errori.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Prezzi mensili (EUR) da scripts/stripe-setup.ts. In alternativa si usano i lookup_key ctrl_quotes_*_monthly.
# STRIPE_PRICE_STARTER_MONTHLY=
# STRIPE_PRICE_STARTER_YEARLY=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_YEARLY=
# STRIPE_PRICE_BUSINESS_MONTHLY=
# STRIPE_PRICE_BUSINESS_YEARLY=
# Tax Rate Stripe "IVA 22%" esclusiva (creata da npm run stripe:setup). Obbligatoria: senza, il checkout dei piani resta chiuso.
STRIPE_TAX_RATE_IVA=

# Stripe Connect (incasso preventivi sul conto dello studio). Endpoint: /api/stripe/connect/webhook
# STRIPE_CONNECT_WEBHOOK_SECRET=

# API interna read-only per l'admin CTRL (sezione Ecosistema). Solo aggregati, niente PII.
# Authorization: Bearer. Senza questa variabile l'endpoint risponde 503.
# ECOSYSTEM_METRICS_SECRET=
